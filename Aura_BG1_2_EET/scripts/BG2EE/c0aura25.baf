    InParty(Myself)
    RealGlobalTimerExpired("C0AuraBG2RomanceTimer","GLOBAL")
	Global("C0AuraRomanceActive","GLOBAL",2)
    !AreaType(DUNGEON)
    See(Player1)
    !See([ENEMY])
    !Range([NEUTRAL],10)
    CombatCounter(0)
	GlobalGT("MelissanJob","GLOBAL",0)
	GlobalLT("C0AuraToBLoveTalk","GLOBAL",2)
THEN
    RESPONSE #100
        SetGlobal("C0AuraToBLoveTalk","GLOBAL",2)
		PlaySong(%C0AUROM%)
        Interact(Player1)
END

