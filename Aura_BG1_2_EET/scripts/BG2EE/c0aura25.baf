	GlobalGT("MelissanJob","GLOBAL",0)
THEN
  RESPONSE #100
        SetGlobal("C0AuraToBLoveTalk","GLOBAL",1)
        RealSetGlobalTimer("C0AuraBG2RomanceTimer","GLOBAL",FIVE_ROUNDS)
END

